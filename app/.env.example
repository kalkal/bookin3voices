# Copy to app/.env (git-ignored) or set as EAS environment variables.
# Leave all of these unset to work 100% against the local Firebase emulators.
# Values come from Firebase console > Project settings > Your apps > Web app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_APP_ID=
# Emulator host (Android emulator: 10.0.2.2; physical device: your PC LAN IP)
# EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
# Force the UI language (en | it); unset = follow the device language
# EXPO_PUBLIC_UI_LANG=en
