rules_version = '2';

// Per-user security rules: only the authenticated owner
// accesses their own users/{uid}/** tree; everything else is denied.
//
// Deliberate choice: EXPLICIT matches on the schema collections instead of
// the recursive wildcard users/{uid}/{document=**}. In Firestore a single
// allowing match is enough to open access, so the wildcard would allow
// bypassing the shape validations. Flip side: a new collection is born
// denied (fail-closed) until it is added here — updating these rules is
// part of every schema evolution.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // schemaVersion present and a positive integer (upgrade-on-read).
    // On update request.resource.data is the resulting document, so the
    // guard also prevents removing the field.
    function hasSchemaVersion() {
      return request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion > 0;
    }

    match /users/{uid} {
      // The schema has no real user document:
      // no rule on the users/{uid} doc itself (it stays denied).

      match /books/{bookId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && hasSchemaVersion();

        match /chapters/{chapterId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && hasSchemaVersion();

          match /sessions/{sessionId} {
            allow read, write: if isOwner(uid);
          }
          match /suggestions/{suggestionId} {
            allow read, write: if isOwner(uid);
          }
          match /revisions/{revisionId} {
            allow read, write: if isOwner(uid);
          }
        }

        // Notebook (ideas/thoughts per book): subcollection of the
        // book. Create/update go through the schemaVersion guard like books
        // and chapters (upgrade-on-read); read/delete only for the owner.
        match /notes/{noteId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && hasSchemaVersion();
        }
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(uid);
      }

      match /styleProfiles/{profileId} {
        allow read, write: if isOwner(uid);
      }

      match /exports/{exportId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Explicit default deny (redundant — Firestore denies whatever no
    // match allows — but it documents the intent).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
