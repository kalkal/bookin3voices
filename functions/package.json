{
  "name": "functions",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "node scripts/copy-style-profiles.mjs && tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "golden": "npm run build && node lib/tools/goldenSetRunner.js",
    "golden:offline": "npm run build && node lib/tools/goldenSetRunner.js --offline",
    "demo:hash": "npm run build && node scripts/demo-code-hash.mjs",
    "check:test-log": "tsc -p tsconfig.build.json && node lib/tools/checkTestLog.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:integration": "jest -c jest.integration.config.js --runInBand",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "docx": "^9.7.1",
    "epub-gen-memory": "1.1.2",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "jszip": "^3.10.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.46.4"
  }
}
