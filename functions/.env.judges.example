# Judges' demo project: copy to functions/.env.<demo project id> (Firebase loads
# it only when deploying to that project). No secret belongs in this file.
# See docs/judges-demo.md.

# The access-code gate on the Nova calls, caps and text limit from config/demo
DEMO_GATE=1

AI_PROVIDER=bedrock
# Nova Pro, as decided for judging: worst case ~$22.8 for the whole demo (docs/judges-demo.md)
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_REGION=us-east-1
# no fallback model in the demo: at most 4 Nova calls per refine
BEDROCK_MODEL_ID_FALLBACK=

# App Check: OFF (the app has no attestation provider yet, docs/judges-demo.md)
ENFORCE_APP_CHECK=0
