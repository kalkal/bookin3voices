# Copy to functions/.env (git-ignored) and adjust. No secret belongs in this file.
# Secrets (AWS keys) go in functions/.secret.local for the emulator and in
# Secret Manager (firebase functions:secrets:set) for production.

# --- AI: Amazon Nova through Amazon Bedrock ---------------------------------
# Model id or inference profile id. Default: Amazon Nova Pro, in-region in us-east-1.
# Cheaper alternative: amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
# Optional: another model for the chapter outline, and a fallback model for refinements.
# BEDROCK_MODEL_ID_OUTLINE=
# BEDROCK_MODEL_ID_FALLBACK=
BEDROCK_REGION=us-east-1
# AWS credentials: standard AWS variables or a profile (AWS_PROFILE), NEVER in this file.
# For the emulator put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in functions/.secret.local.
